{
    "retriever": "reasonir/ReasonIR-8B",
    "reranker": "Qwen/Qwen2.5-7B-Instruct",
    "retriever_device": "cuda:1",
    "reranker_device": "cuda:2",
    "m_retrieval": 1,
    "m_reranking": 10,
    "final_score_delta": 0.5,
    "ranking_score_normalization": true,
    "passage_length": 512,
    "label_sep_token": "<LABEL-SEP>",
    "tokenizer_begin_token": "<|begin_of_text|>",
    "query_expansion": "left",
    "enable_query_context_window": true,
    "query_context": 256,
    "sc_retriever_topk": 10,
    "retriever_topk": 20,
    "reranker_topk": 12,
    "retr_batch_size": 6,
    "rera_sc_permutation_mode": "stb",
    "rera_passages_per_call": 4,
    "reranker_temperature": 0.6
}